  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c8ca8122e44aca4695dc40d1a9c4b3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyText: {fileID: 1702091986}
  firstText: "Lors de cette tragique nuit, les t\xE9n\xE8bres revinrent. Le village
    fut ravag\xE9, et parmi les corps calcin\xE9s ne surv\xE9cut qu\u2019un enfant. "
  secondText: "Il grandit au milieu des ruines, abreuv\xE9 d\u2019histoires de monstres,
    hant\xE9 par les cicatrices qu\u2019ils avaient laiss\xE9es sur son monde et
    sur son \xE2me. "
  thirdText: "Devenu un homme, il refusa de c\xE9der \xE0 la peur. Arm\xE9 de d\xE9termination
    et de col\xE8re, il quitta son village jurant de briser ce cycle de terreur qui
    avait \xE9touff\xE9 les siens."
  firstTextDuration: 6
  secondTextDuration: 6
  thirdTextDuration: 6
  fadeInDuration: 1.5
  fadeOutDuration: 1.5
  autoTransitionToNextLevel: 1
  delayBeforeTransition: 1
  _bPlaySound: 0
  _bPlayEvent: 0
  soundVolume: 1
  whichMoment: else
  eventCalled: {fileID: 0}
  delayOpacity: 5
