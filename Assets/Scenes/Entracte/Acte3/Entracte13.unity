  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2c8ca8122e44aca4695dc40d1a9c4b3d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  storyText: {fileID: 1702091986}
  firstText: "Lorsque le combat fut termin\xE9. L\u2019Homme Sans Nom ne cria pas,
    ne supplia pas. Il s\u2019effondra comme s\u2019il \xE9tait enfin lib\xE9r\xE9.\LEt
    la corruption qu\u2019il portait s\u2019\xE9coula hors de lui pour se jeter dans
    son vainqueur."
  secondText: "Et dans un village lointain, quelque part, un enfant survivra encore
    \xE0 une nuit de cendres\u2026\Lun enfant qui, \xE0 son tour, prendra les armes\u2026"
  thirdText: "Car le cycle ne se brise jamais.\LIl se transmet."
  firstTextDuration: 6
  secondTextDuration: 6
  thirdTextDuration: 6
  fadeInDuration: 1.5
  fadeOutDuration: 1.5
  autoTransitionToNextLevel: 1
  delayBeforeTransition: 3
  _bPlaySound: 1
  soundVolume: 0.2
  whichMoment: else
