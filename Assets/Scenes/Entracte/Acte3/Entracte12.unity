  m_EditorClassIdentifier: 
  storyText: {fileID: 1702091986}
  firstText: " Sur un tr\xF4ne de pierre \xE9rod\xE9e, se tenait un homme. Immobile.
    Silencieux.\L Comme une statue qui aurait attendu des si\xE8cles que quelqu\u2019un
    ose monter jusqu\u2019\xE0 lui."
  secondText: "Le h\xE9ros comprit aussit\xF4t : cet homme n\u2019\xE9tait pas un
    d\xE9mon\u2026 mais un successeur.\LUn h\xE9ritier.\LUn humain d\xE9form\xE9
    par la m\xEAme corruption qui, peu \xE0 peu, consumait son propre corps."
  thirdText: 
  firstTextDuration: 6
  secondTextDuration: 6
  thirdTextDuration: 0
  fadeInDuration: 1.5
  fadeOutDuration: 1.5
